{
  "name": "openone",
  "version": "0.1.0",
  "private": true,
  "description": "Edge-dock for Windows and macOS that watches your tmux/psmux agent panes and jumps to them in your terminal",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "icons": "electron tools/render-icons.js",
    "dist": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac --arm64"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.15.3"
  },
  "productName": "openone",
  "author": "csaben",
  "license": "MIT",
  "build": {
    "appId": "com.csaben.openone",
    "productName": "openone",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "assets/**",
      "package.json",
      "!node_modules/onnxruntime-web/dist/**",
      "node_modules/onnxruntime-web/dist/ort.node.min.js",
      "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.mjs",
      "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm"
    ],
    "asarUnpack": [
      "src/wt-focus.ps1",
      "assets/**",
      "src/embed-worker.js",
      "node_modules/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/app-256.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/app-512.png",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "openone records while you hold push-to-talk.",
        "NSAppleEventsUsageDescription": "openone brings the right Terminal tab forward when you jump to an agent."
      }
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "openone",
      "artifactName": "openone-setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "@xterm/addon-serialize": "0.13.0",
    "@xterm/headless": "5.5.0",
    "onnxruntime-web": "1.22.0",
    "uiohook-napi": "^1.5.4"
  }
}
