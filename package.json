{
  "name": "openone",
  "version": "0.1.0",
  "private": true,
  "description": "Windows edge-dock that watches your tmux/psmux agent panes and jumps to them in Windows Terminal",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "icons": "electron tools/render-icons.js",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.15.3"
  },
  "productName": "openone",
  "author": "csaben",
  "license": "MIT",
  "build": {
    "appId": "com.csaben.openone",
    "productName": "openone",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "assets/**",
      "package.json",
      "!node_modules/onnxruntime-web/dist/**",
      "node_modules/onnxruntime-web/dist/ort.node.min.js",
      "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.mjs",
      "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm"
    ],
    "asarUnpack": [
      "src/wt-focus.ps1",
      "assets/**",
      "src/embed-worker.js",
      "node_modules/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/app-256.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "openone",
      "artifactName": "openone-setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "@xterm/addon-serialize": "0.13.0",
    "@xterm/headless": "5.5.0",
    "onnxruntime-web": "1.22.0"
  }
}
